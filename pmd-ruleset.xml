<?xml version="1.0"?>
<ruleset name="Limen complexity ruleset"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_2_0_0.xsd">

    <description>
        Complexity-only ruleset. PMD is configured as a reporting tool, not
        a gate — findings are surfaced in `docs/reports/code-quality.{md,json}`,
        regenerated automatically by `mvn verify`, and the build does not fail
        on findings. Rules here exist to inform refactoring, not block PRs.
        See `docs/process/code-quality.md` for the regen flow.

        Future expansion of this ruleset (Best Practices, Error Prone PMD-rules,
        Performance categories) is tracked in #189 — add categories one at a
        time so each addition's diff in `code-quality.json` shows exactly which
        findings the new rules introduced.
    </description>

    <!-- "Method does too much" signals -->
    <rule ref="category/java/design.xml/CognitiveComplexity"/>
    <rule ref="category/java/design.xml/CyclomaticComplexity"/>
    <rule ref="category/java/design.xml/NPathComplexity"/>
    <rule ref="category/java/design.xml/NcssCount"/>
    <rule ref="category/java/design.xml/ExcessiveParameterList"/>

    <!-- "Class does too much" signals -->
    <rule ref="category/java/design.xml/GodClass"/>
    <rule ref="category/java/design.xml/TooManyFields"/>
    <rule ref="category/java/design.xml/TooManyMethods"/>
    <rule ref="category/java/design.xml/ExcessivePublicCount"/>

    <!--
        Forgotten-code + small-correctness signals (added per #189).
        Three rules in this category are excluded because every finding
        they produce in this codebase is pattern-specific noise rather
        than a real refactoring opportunity:

        - AbstractClassWithoutAbstractMethod: the only matches are
          Jackson `*Mixin` classes whose abstractness is a marker (they
          are never instantiated; Jackson reads their annotations),
          which the rule doesn't model.
        - GuardLogStatement: slf4j's parameterised logging is already
          lazy, so wrapping `log.x("foo {}", v)` in `isXEnabled()`
          guards adds boilerplate without measurable benefit. The
          existing flagged sites are an audit hot path, a dev-profile
          email logger, and a once-a-day scheduled job.
        - LooseCoupling: `EnumMap` / `ConcurrentHashMap` are declared
          as their concrete types deliberately because the semantics
          (enum-keyed iteration order, thread-safety) are part of the
          contract; downgrading to `Map` would silently lose them.
    -->
    <rule ref="category/java/bestpractices.xml">
        <exclude name="AbstractClassWithoutAbstractMethod"/>
        <exclude name="GuardLogStatement"/>
        <exclude name="LooseCoupling"/>
    </rule>

    <!--
        Bug-pattern detection (added per #189). Distinct from the
        Error Prone compiler plugin already wired into maven-compiler-plugin
        — different rules, different mechanism. PMD's Error Prone catches
        latent bugs and footguns that aren't covered by the compiler-plugin
        version (e.g. AvoidLiteralsInIfCondition, UseLocaleWithCaseConversions,
        UseProperClassLoader).

        Six rules in this category are excluded because every finding
        they produce in this codebase is project/library-pattern noise
        rather than a real bug or refactoring opportunity:

        - AvoidFieldNameMatchingMethodName: Java records and bean
          accessors deliberately match field name with the auto-generated
          method name (it's a language feature, not a smell).
        - MissingSerialVersionUID + NonSerializableClass: Spring
          exception classes and `TenantUserDetails` implement
          Serializable for framework reasons; this app has no
          cross-JVM serialization story, so the rules' premise doesn't
          apply.
        - ReplaceJavaUtilDate: every match is
          `TenantPersistentTokenBasedRememberMeServices` /
          `TenantPersistentRememberMeToken`, both implementing Spring
          Security's `RememberMeServices` API which forces
          `java.util.Date`. We can't change the API.
        - AvoidDuplicateLiterals: most matches are template-binding
          attribute names (`"slug"`, `"app"`, `"client"`) and Spring
          redirect prefixes; signal-to-noise is too low for routine
          surfacing. Re-evaluate if/when a churning-strings refactor
          is on the table.
        - AvoidCatchingGenericException: every match is a deliberate
          boundary safety-net (filter doFilterInternal, scheduled job,
          audit dispatch); the rule doesn't model the
          "absorb-anything-from-below-here" pattern.
    -->
    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidCatchingGenericException"/>
        <exclude name="AvoidDuplicateLiterals"/>
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <exclude name="MissingSerialVersionUID"/>
        <exclude name="NonSerializableClass"/>
        <exclude name="ReplaceJavaUtilDate"/>
    </rule>

    <!--
        Performance hot-path signals (added per #189). PMD's Performance
        category is a mixed bag — some rules catch real footguns
        (`AddEmptyString` flags `"" + first + …`-style concatenation
        chains), others are cargo-culted micro-optimisation noise.

        One rule is excluded outright:

        - AvoidInstantiatingObjectsInLoops: heuristic too broad. Every
          finding in this codebase is a per-iteration allocation that
          the JIT escape-analyses away (e.g. `computeIfAbsent` lookup
          keys for a small static rule set, per-event objects, builder
          DTOs). The premise pre-dates modern GC + escape analysis.
    -->
    <rule ref="category/java/performance.xml">
        <exclude name="AvoidInstantiatingObjectsInLoops"/>
    </rule>
</ruleset>

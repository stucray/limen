# Copy to .env (gitignored) and fill in values.
# See docs/process/local-setup.md for first-time setup.

# 32-byte AES key, base64-encoded. Wraps each tenant's RSA signing-key
# private bytes at rest. Required — the app will fail to start without it.
# Generate a fresh value with:
#   openssl rand -base64 32
LIMEN_SECURITY_KEK=

# Optional: pre-create a system-admin account on first boot. Both must be
# set together, or both left blank. If unset, run `./mvnw spring-boot:run`
# without them and create the first admin via the signup flow.
LIMEN_BOOTSTRAP_ADMIN_EMAIL=
LIMEN_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: override the `From:` address on outbound email. The base default
# (`no-reply@limen.local`) is fine for logging + Mailpit (both accept any
# address). Real SMTP relays (Resend, Brevo, SES, …) reject sends from
# domains they don't own — set this to a verified-domain address when
# pointing at a real provider, e.g.
#   LIMEN_EMAIL_FROM=no-reply@yourdomain.com
LIMEN_EMAIL_FROM=

# Optional: point at a real SMTP relay. Leave blank to use the dev defaults
# (logging driver in tests, Mailpit on `mvn spring-boot:run`). To send via
# Resend, for example:
#   LIMEN_EMAIL_DRIVER=smtp
#   SPRING_MAIL_HOST=smtp.resend.com
#   SPRING_MAIL_PORT=587
#   SPRING_MAIL_USERNAME=resend
#   SPRING_MAIL_PASSWORD=re_xxxxxxxxxxxx
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
LIMEN_EMAIL_DRIVER=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=

# Copy to .env (gitignored) and fill in values.
# See docs/process/local-setup.md for first-time setup.

# 32-byte AES key, base64-encoded. Wraps each tenant's RSA signing-key
# private bytes at rest. Required — the app will fail to start without it.
# Generate a fresh value with:
#   openssl rand -base64 32
LIMEN_SECURITY_KEK=

# Optional: previous-generation KEK used as a decrypt-only fallback when the
# active KEK above fails to authenticate an at-rest ciphertext. Set this to
# the prior LIMEN_SECURITY_KEK during a KEK rotation so existing tenant
# signing keys keep loading; reads that fall through re-wrap with the active
# KEK and a fresh salt, so the column drains lazily on its own. Remove (or
# leave blank) once you're confident no rows are still wrapped under it.
LIMEN_SECURITY_KEK_PREVIOUS=

# Optional: pre-create a system-admin account on first boot. Both must be
# set together, or both left blank. If unset, run `./mvnw spring-boot:run`
# without them and create the first admin via the signup flow.
LIMEN_BOOTSTRAP_ADMIN_EMAIL=
LIMEN_BOOTSTRAP_ADMIN_PASSWORD=

# Production email via Resend. Leave blank to use the dev defaults (logging
# driver in tests, Mailpit on `mvn spring-boot:run`). To send via Resend in
# any environment, activate the `resend` Spring profile and set these two:
#
#   SPRING_PROFILES_ACTIVE=resend
#   LIMEN_EMAIL_FROM=no-reply@your-verified-domain.com
#   SPRING_MAIL_PASSWORD=re_xxxxxxxxxxxx
#
# The `resend` profile (src/main/resources/application-resend.yaml) bakes in
# the Resend SMTP shape — host, port, username, STARTTLS — so deploy-time
# config is just the From-address and the API key.
#
# Before your domain's DNS is verified in the Resend dashboard, you can
# smoke-test with `LIMEN_EMAIL_FROM=onboarding@resend.dev` — but Resend will
# only deliver from that address to your own logged-in Resend-account email.
SPRING_PROFILES_ACTIVE=
LIMEN_EMAIL_FROM=
SPRING_MAIL_PASSWORD=

# OAuth2 client redirect URIs are registered through the manage UI, not
# here. For local development, prefer the loopback IP form so the port is
# wildcarded — register once and any local port works on both /authorize
# and /connect/logout:
#
#   redirect URI:                http://127.0.0.1:8080/callback
#   post-logout redirect URI:    http://127.0.0.1:8080/logged-out
#
# See "Registering a loopback redirect URI" in
# docs/process/local-setup.md for the full rule and caveats (localhost is
# NOT loopback for matching; HTTPS loopback is exact-port-only).
